<h1>List of <%= @trainings.count %> Trainings</h1>

<table border="1">
  <tr>
    <th>Training number</th>
    <th>Date Started</th>
    <th>Date Ended</th>
  </tr>
  <% @trainings.each do |training| %>
    <tr>
      <td><%= training.training_number %></td>
      <td><%= training.start_date.strftime("%-m/%-d/%Y") %></td>
      <td><%= training.end_date.strftime("%-m/%-d/%Y") %></td>
    </tr>
  <% end %>
</table>

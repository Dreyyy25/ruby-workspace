<h1>New Training</h1>

<%= form_with model: @training, url: "/trainings" do |form| %>
  <% if @training.errors.any? %>
    <div style="color: red;">
      <h2><%= pluralize(@training.errors.count, "error") %> prohibited this training from being saved:</h2>
      <ul>
        <% @training.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 8px;">
    <%= form.label :date_start %><br>
    <%= form.date_field :date_start %>
  </div>

  <div style="margin-bottom: 8px;">
    <%= form.label :date_end %><br>
    <%= form.date_field :date_end %>
  </div>

  <%= form.submit "Create Training" %>
<% end %>

<%= link_to "Back to trainings", "/trainings" %>

<div style="width: 750px; margin: 40px auto; font-family: sans-serif;">
  <% if flash[:notice] %>
    <div style="color: green; border: 1px solid green; padding: 10px; margin-bottom: 20px; background-color: #e6ffe6;">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <h1>Training #<%= @training.training_number %> <a href="/trainings/<%= @training.id %>/edit" style="font-size: 16px;">Edit</a></h1>
  <p><strong>Start Date:</strong> <%= @training.date_started.strftime("%-m/%-d/%Y") %></p>
  <p><strong>End Date:</strong> <%= @training.date_ended.strftime("%-m/%-d/%Y") %></p>

  <br>

  <table style="width: 100%; border-collapse: collapse; margin-top: 15px; border: 2px solid black;">
    <thead>
      <tr style="background-color: #e0e0e0; text-align: left;">
        <th style="border: 1px solid black; padding: 8px;">Last Name</th>
        <th style="border: 1px solid black; padding: 8px;">First Name</th>
        <th style="border: 1px solid black; padding: 8px;">Job Role</th>
        <th style="border: 1px solid black; padding: 8px;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @training.alumni.each do |alumn| %>
        <tr>
          <td style="border: 1px solid black; padding: 8px;"><%= alumn.last_name %></td>
          <td style="border: 1px solid black; padding: 8px;"><%= alumn.first_name %></td>
          <td style="border: 1px solid black; padding: 8px;"><%= alumn.job_role %></td>
          <td style="border: 1px solid black; padding: 8px; display: flex; gap: 8px; align-items: center;">
            <a href="/trainings/<%= @training.id %>/alumni/<%= alumn.id %>">Show</a> |
            <a href="/trainings/<%= @training.id %>/alumni/<%= alumn.id %>/edit">Edit</a> |

            <form action="/trainings/<%= @training.id %>/alumni/<%= alumn.id %>" method="post" style="display: inline; margin: 0;">
              <input type="hidden" name="_method" value="delete">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <input type="submit" value="Delete" onclick="return confirm('Are you sure?')" style="background: none; border: none; color: blue; text-decoration: underline; cursor: pointer; padding: 0; font-size: inherit;">
            </form>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br>
  <div style="display: flex; justify-content: space-between;">
    <a href="/trainings">Create new Training</a>
    <a href="/trainings/<%= @training.id %>/alumni/new">Add Alumn</a>
  </div>
</div>
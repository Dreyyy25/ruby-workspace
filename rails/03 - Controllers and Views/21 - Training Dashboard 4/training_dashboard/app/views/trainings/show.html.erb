<div class="training-profile-container">

  <div class="training-profile">

    <h1>Training #<%= @training.training_number %></h1>

    <div class="training-details">

      <div class="training-detail">
        <strong>Training Number</strong>
        <p><%= @training.training_number %></p>
      </div>

      <div class="training-detail">
        <strong>Date Started</strong>
        <p>
          <%= @training.date_started.strftime("%m/%d/%Y") %>
        </p>
      </div>

      <div class="training-detail">
        <strong>Date Ended</strong>
        <p>
          <%= @training.date_ended.strftime("%m/%d/%Y") %>
        </p>
      </div>

    </div>

    <div class="training-actions">

      <a href="/trainings/<%= @training.id %>/edit">
        Edit Training
      </a>

    </div>

    <a href="/trainings" class="back-link">
      ← Back to Trainings
    </a>

  </div>

</div>

<div class="alumni-section">

  <div class="alumni-header">
    <h2>Alumni</h2>

    <a href="/trainings/<%= @training.id %>/alumni/new"
       class="create-button">
      + Add Alumn
    </a>
  </div>

  <% @training.alumns.each do |alumn| %>

    <div class="alumn-card">

      <div>
        <h3>
          <%= alumn.first_name %>
          <%= alumn.last_name %>
        </h3>

        <p><%= alumn.job_role %></p>
      </div>

      <a href="/batches/<%= @training.id %>/graduates/<%= alumn.id %>">
        View Alumn
      </a>

    </div>

  <% end %>

</div>
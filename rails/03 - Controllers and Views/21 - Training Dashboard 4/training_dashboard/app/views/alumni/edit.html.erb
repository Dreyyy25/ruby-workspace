<h1>Editing <%= @alumn.first_name %> <%= @alumn.last_name %></h1>

<% if @alumn.errors.any? %>
  <div style="color: red;">
    <h3><%= pluralize(@alumn.errors.count, "error") %> prohibited this alumn from being saved:</h3>
    <ul>
      <% @alumn.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form action="/trainings/<%= @training.id %>/alumni/<%= @alumn.id %>" method="post">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <input type="hidden" name="_method" value="patch">
  <p>Last Name: <input type="text" name="alumn[last_name]" value="<%= @alumn.last_name %>"></p>
  <p>First Name: <input type="text" name="alumn[first_name]" value="<%= @alumn.first_name %>"></p>
  <p>Job Role: <input type="text" name="alumn[job_role]" value="<%= @alumn.job_role %>"></p>
  <p>Training #:
    <select name="alumn[training_id]">
      <% @trainings.each do |training| %>
        <option value="<%= training.id %>" <%= "selected" if training.id == @alumn.training_id %>><%= training.training_number %></option>
      <% end %>
    </select>
  </p>
  <input type="submit" value="Update">
</form>

<p>
  <%= link_to "Home", "/trainings" %>
  <%= link_to @alumn.first_name, "/trainings/#{@training.id}/alumni/#{@alumn.id}" %>
</p>

<div style="width: 850px; margin: 30px auto; font-family: sans-serif;">
  
  <!-- Header & Money Display -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Your money: <%= @money %></h2>
    <form action="/game/reset" method="post" style="margin: 0;">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="submit" value="Reset Game" style="background-color: #d9534f; color: white; border: none; padding: 8px 16px; border-radius: 4px; font-weight: bold; cursor: pointer;">
    </form>
  </div>

  <!-- Risk Cards Row -->
  <div style="display: flex; gap: 20px; margin-bottom: 30px;">
    
    <!-- Low Risk -->
    <div style="border: 2px solid black; padding: 20px 10px; width: 25%; text-align: center;">
      <h3>Low Risk</h3>
      <form action="/game/low" method="post" style="margin: 15px 0;">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="submit" value="Bet" style="background-color: #5cb85c; color: white; border: none; padding: 6px 20px; font-weight: bold; border-radius: 3px; cursor: pointer;">
      </form>
      <p style="margin-bottom: 0;">by -25 up to 100</p>
    </div>

    <!-- Moderate Risk -->
    <div style="border: 2px solid black; padding: 20px 10px; width: 25%; text-align: center;">
      <h3>Moderate Risk</h3>
      <form action="/game/moderate" method="post" style="margin: 15px 0;">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="submit" value="Bet" style="background-color: #5cb85c; color: white; border: none; padding: 6px 20px; font-weight: bold; border-radius: 3px; cursor: pointer;">
      </form>
      <p style="margin-bottom: 0;">by -100 up to 1000</p>
    </div>

    <!-- High Risk -->
    <div style="border: 2px solid black; padding: 20px 10px; width: 25%; text-align: center;">
      <h3>High Risk</h3>
      <form action="/game/high" method="post" style="margin: 15px 0;">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="submit" value="Bet" style="background-color: #5cb85c; color: white; border: none; padding: 6px 20px; font-weight: bold; border-radius: 3px; cursor: pointer;">
      </form>
      <p style="margin-bottom: 0;">by -500 up to 2500</p>
    </div>

    <!-- Severe Risk -->
    <div style="border: 2px solid black; padding: 20px 10px; width: 25%; text-align: center;">
      <h3>Severe Risk</h3>
      <form action="/game/severe" method="post" style="margin: 15px 0;">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="submit" value="Bet" style="background-color: #5cb85c; color: white; border: none; padding: 6px 20px; font-weight: bold; border-radius: 3px; cursor: pointer;">
      </form>
      <p style="margin-bottom: 0;">by -3000 up to 5000</p>
    </div>

    <!-- Double or Nothing -->
    <div style="border: 2px solid gold; background-color: #fffdf0; padding: 20px 10px; width: 20%; text-align: center;">
    <h3 style="color: #b8860b;">Double or Nothing</h3>
    <form action="/game/double_or_nothing" method="post" style="margin: 15px 0;">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="submit" value="Gamble!" style="background-color: #d9534f; color: white; border: none; padding: 6px 20px; font-weight: bold; border-radius: 3px; cursor: pointer;">
    </form>
    <p style="margin-bottom: 0; font-size: 13px;">50% 2x Money / 50% $0</p>
    </div>

  </div>

  <!-- Game Host Activity Logs -->
  <h3>Game Host:</h3>
  <div style="border: 2px solid black; height: 180px; overflow-y: scroll; padding: 10px; background-color: #ffffff;">
    <% @activities.each do |act| %>
      <p style="color: <%= act['style'] %>; margin: 6px 0; font-family: monospace; font-size: 14px;">
        <%= act['message'] %>
      </p>
    <% end %>
  </div>

</div>
<h1>List of <%= @dojos.count %> Dojos</h1>

<table border="1">
  <tr>
    <th>Branch</th>
    <th>Street</th>
    <th>City</th>
    <th>State</th>
  </tr>
  <% @dojos.each do |dojo| %>
    <tr>
      <td><%= dojo.branch %></td>
      <td><%= dojo.street %></td>
      <td><%= dojo.city %></td>
      <td><%= dojo.state %></td>
    </tr>
  <% end %>
</table>

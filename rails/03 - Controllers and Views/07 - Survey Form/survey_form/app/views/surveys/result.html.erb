<% if flash[:notice] %>
  <div class="notice"><%= flash[:notice] %></div>
<% end %>

<div class="box">
  <h2>Submitted Information</h2>
  <p>Name: <%= @survey["name"] %></p>
  <p>Dojo Location: <%= @survey["location"] %></p>
  <p>Favorite Language: <%= @survey["language"] %></p>
  <p>Comment: <%= @survey["comment"] %></p>
  <a href="/">Go Back</a>
</div>

<div style="width: 700px; margin: 40px auto; font-family: sans-serif;">
  <% if flash[:notice] %>
    <div style="color: green; border: 1px solid green; padding: 10px; margin-bottom: 20px; background-color: #e6ffe6;">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <h1><%= @dojo.branch %></h1>
  <p><strong>Street:</strong> <%= @dojo.street %></p>
  <p><strong>City:</strong> <%= @dojo.city %></p>
  <p><strong>State:</strong> <%= @dojo.state %></p>

  <a href="/dojos/<%= @dojo.id %>/edit">Edit Dojo</a> |
  <a href="/dojos">Home</a>

  <hr style="margin: 30px 0;">

  <h2>Students (<%= @dojo.students.count %>)</h2>

  <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
    <thead>
      <tr style="background-color: #f2f2f2; text-align: left;">
        <th style="border: 1px solid #ddd; padding: 8px;">First Name</th>
        <th style="border: 1px solid #ddd; padding: 8px;">Last Name</th>
        <th style="border: 1px solid #ddd; padding: 8px;">Email</th>
        <th style="border: 1px solid #ddd; padding: 8px;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @dojo.students.each do |student| %>
        <tr>
          <td style="border: 1px solid #ddd; padding: 8px;"><%= student.first_name %></td>
          <td style="border: 1px solid #ddd; padding: 8px;"><%= student.last_name %></td>
          <td style="border: 1px solid #ddd; padding: 8px;"><%= student.email %></td>
          <td style="border: 1px solid #ddd; padding: 8px; display: flex; gap: 8px; align-items: center;">
            <a href="/dojos/<%= @dojo.id %>/students/<%= student.id %>">Show</a>
            <a href="/dojos/<%= @dojo.id %>/students/<%= student.id %>/edit">Edit</a>

            <form action="/dojos/<%= @dojo.id %>/students/<%= student.id %>" method="post" style="display: inline; margin: 0;">
              <input type="hidden" name="_method" value="delete">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <input type="submit" value="Destroy" onclick="return confirm('Are you sure?')" style="background: none; border: none; color: blue; text-decoration: underline; cursor: pointer; padding: 0; font-size: inherit;">
            </form>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br>
  <a href="/dojos/<%= @dojo.id %>/students/new">Add Student</a>
</div>
<h1>Dojo <%= @dojo[:id] %></h1>
<p style="color: green"><%= notice %></p>

<div style="border: 1px solid black; margin: 2px; padding: 4px;">
    <p><%= @dojo[:branch] %></p>
    <p><%= @dojo[:state] %></p>
    <p><%= @dojo[:city] %></p>
    <p><%= @dojo[:street] %></p>
</div>

<div>
  <%= link_to "Edit this dojo", "/dojos/#{@dojo[:id]}/edit" %> |
  <%= link_to "Back to dojos", "/dojos" %> |
  <%= button_to "Delete dojo", "/dojos/#{@dojo[:id]}", method: :delete %>

</div>

<hr>

<h2>Students</h2>
<%= link_to "Add student", "/dojos/#{@dojo[:id]}/students/new" %>

<table border=1>
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <% @students.each do |student| %>
            <tr>
                <td> <%= student[:first_name] %> </td>
                <td> <%= student[:last_name] %> </td>
                <td> <%= student[:email] %> </td>
                <td> <%= link_to "View Student", "/dojos/#{@dojo[:id]}/students/#{student[:id]}" %> </td>
            </tr>
        <% end %>
    </tbody>
</table>
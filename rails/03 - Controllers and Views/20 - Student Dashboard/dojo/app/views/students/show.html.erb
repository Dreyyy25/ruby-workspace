<h2>Student #<%= @student[:id]%></h2>

<table border=1>
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td> <%= @student[:first_name] %> </td>
            <td> <%= @student[:last_name] %> </td>
            <td> <%= @student[:email] %> </td>
        </tr>
    </tbody>
</table>

<%= link_to "Edit student", "/dojos/#{@student[:dojo_id]}/students/#{@student[:id]}/edit" %>
<%= button_to "Delete student", "/dojos/#{@student[:dojo_id]}/students/#{@student[:id]}", method: :delete%>
<%= link_to "Return to dojo", "/dojos/#{@student[:dojo_id]}" %>
<h1>Students of Dojo # <%= @dojo.id %></h1>

<table border="1">
  <tr>
    <th>Last Name</th>
    <th>First Name</th>
    <th>Email</th>
    <th>Actions</th>
  </tr>
  <% @students.each do |student| %>
    <tr>
      <td><%= student.last_name %></td>
      <td><%= student.first_name %></td>
      <td><%= student.email %></td>
      <td><%= link_to "Show", "/dojos/#{@dojo.id}/students/#{student.id}" %></td>
    </tr>
  <% end %>
</table>

<p>
  <%= link_to "Home", "/dojos" %>
  <%= link_to "Dojo #{@dojo.id}", "/dojos/#{@dojo.id}" %>
</p>

<h1>Dojo # <%= @dojo.id %></h1>

<p>Branch: <%= @dojo.branch %></p>
<p>Street: <%= @dojo.street %></p>
<p>City: <%= @dojo.city %></p>
<p>State: <%= @dojo.state %></p>

<table border="1">
  <tr>
    <th>Last Name</th>
    <th>First Name</th>
    <th>Email</th>
    <th>Actions</th>
  </tr>
  <% @dojo.students.each do |student| %>
    <tr>
      <td><%= student.last_name %></td>
      <td><%= student.first_name %></td>
      <td><%= student.email %></td>
      <td>
        <%= link_to "Show", "/dojos/#{@dojo.id}/students/#{student.id}" %> |
        <%= link_to "Edit", "/dojos/#{@dojo.id}/students/#{student.id}/edit" %> |
        <form action="/dojos/<%= @dojo.id %>/students/<%= student.id %>" method="post" style="display: inline;">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <input type="hidden" name="_method" value="delete">
          <input type="submit" value="Delete">
        </form>
      </td>
    </tr>
  <% end %>
</table>

<p><%= link_to "Add Student", "/dojos/#{@dojo.id}/students/new" %></p>

<p>
  <%= link_to "Home", "/dojos" %>
  <%= link_to "Edit", "/dojos/#{@dojo.id}/edit" %>
</p>

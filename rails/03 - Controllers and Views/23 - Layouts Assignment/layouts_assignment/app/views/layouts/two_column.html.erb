<!DOCTYPE html>
<html>
<head>
  <title>Two Column Layout</title>

  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <%= csrf_meta_tags %>
</head>

<body>

  <div class="container">
    <div class="row">

      <div class="col-md-6">
        <%= yield :left %>
      </div>

      <div class="col-md-6">
        <%= yield :right %>
      </div>

    </div>
  </div>

</body>
</html>
<% content_for :left do %>
  <h1>Posts</h1>

  <table class="table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Content</th>
        <th>User</th>
      </tr>
    </thead>

    <tbody>
      <% @posts.each do |post| %>
        <tr>
          <td><%= post.title %></td>
          <td><%= post.content %></td>
          <td>
            <%= post.user.first_name %> <%= post.user.last_name %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% content_for :middle do %>
  <h1>New Post</h1>

  <form>
    <div class="mb-3">
      <label class="form-label">Title</label>
      <input type="text" name="title" class="form-control">
    </div>

    <div class="mb-3">
      <label class="form-label">Content</label>
      <textarea name="content" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
      Create Post
    </button>
  </form>
<% end %>

<% content_for :right do %>
  <h1>Users</h1>

  <%= link_to "Go to Users", "/users" %>
<% end %>
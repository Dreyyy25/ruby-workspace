<% content_for :left_column do %>
  <h2>All Users</h2>

  <table class="table table-bordered table-striped">
    <thead>
      <tr>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Favorite Language</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |u| %>
        <tr>
          <td><%= u.first_name %></td>
          <td><%= u.last_name %></td>
          <td><%= u.favorite_language %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% content_for :right_column do %>
  <h2>New User</h2>

  <% if @user && @user.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <form action="/users" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

    <div class="form-group mb-3">
      <label>First Name:</label>
      <input type="text" name="user[first_name]" class="form-control" value="<%= @user&.first_name %>">
    </div>

    <div class="form-group mb-3">
      <label>Last Name:</label>
      <input type="text" name="user[last_name]" class="form-control" value="<%= @user&.last_name %>">
    </div>

    <div class="form-group mb-3">
      <label>Favorite Language:</label>
      <input type="text" name="user[favorite_language]" class="form-control" value="<%= @user&.favorite_language %>">
    </div>

    <input type="submit" value="Create User" class="btn btn-primary mb-3">
  </form>

  <a href="/posts" class="btn btn-link">Go to Posts Page</a>
<% end %>
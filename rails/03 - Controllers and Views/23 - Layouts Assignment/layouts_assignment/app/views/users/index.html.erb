<% content_for :left do %>
  <h1>Users</h1>

  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
      </tr>
    </thead>

    <tbody>
      <tr>
        <td>John Doe</td>
      </tr>
      <tr>
        <td>Jane Doe</td>
      </tr>
      <tr>
        <td>Mike Smith</td>
      </tr>
    </tbody>
  </table>
<% end %>

<% content_for :right do %>
  <h1>New User</h1>

  <form>
    <div class="mb-3">
      <label class="form-label">Name</label>
      <input type="text" name="name" class="form-control">
    </div>

    <button type="submit" class="btn btn-primary">
      Create User
    </button>
  </form>

  <br>

  <%= link_to "Go to Posts", "/posts" %>
<% end %>
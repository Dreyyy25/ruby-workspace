<h1>New Seminar</h1>

<%= form_with model: @seminar, url: "/seminars" do |form| %>
  <% if @seminar.errors.any? %>
    <div style="color: red;">
      <h2><%= pluralize(@seminar.errors.count, "error") %> prohibited this seminar from being saved:</h2>
      <ul>
        <% @seminar.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 8px;">
    <%= form.label :date_start %><br>
    <%= form.date_field :date_start %>
  </div>

  <div style="margin-bottom: 8px;">
    <%= form.label :date_end %><br>
    <%= form.date_field :date_end %>
  </div>

  <%= form.submit "Create Seminar" %>
<% end %>

<%= link_to "Back to Seminars", "/seminars" %>

<h1>New Seminar</h1>

<% if @seminar.errors.any? %>
  <div style="color: red;">
    <h3><%= pluralize(@seminar.errors.count, "error") %> prohibited this seminar from being saved:</h3>
    <ul>
      <% @seminar.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form action="/seminars" method="post">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <p>Seminar number: <input type="text" name="seminar[seminar_number]" value="<%= @seminar.seminar_number %>"></p>
  <p>Start Date: <input type="date" name="seminar[start_date]" value="<%= @seminar.start_date %>"></p>
  <p>End Date: <input type="date" name="seminar[end_date]" value="<%= @seminar.end_date %>"></p>
  <input type="submit" value="Create">
</form>

<p><%= link_to "Go Back", "/seminars" %></p>

<div class="seminar-form-container">

  <h1>Create a New Seminar</h1>

  <% if @seminar.errors.any? %>
    <div class="error-box">
      <h2>Please fix the following errors:</h2>

      <ul>
        <% @seminar.errors.full_messages.each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <form action="/seminars" method="POST">

    <div class="form-group">
      <label for="seminar_number">Seminar Number</label>

      <input
        type="number"
        id="seminar_number"
        name="seminar[seminar_number]"
        value="<%= @seminar.seminar_number %>"
        min="1"
        step="1"
        placeholder="Enter seminar number"
        required
      >
    </div>

    <div class="form-group">
      <label for="date_started">Date Started</label>

      <input
        type="date"
        id="date_started"
        name="seminar[date_started]"
        value="<%= @seminar.date_started %>"
        required
      >
    </div>

    <div class="form-group">
      <label for="date_ended">Date Ended</label>

      <input
        type="date"
        id="date_ended"
        name="seminar[date_ended]"
        value="<%= @seminar.date_ended %>"
        required
      >
    </div>

    <button type="submit" class="submit-button">
      Create Seminar
    </button>

  </form>

  <a href="/seminars" class="back-link">
    ← Back to Seminars
  </a>

</div>
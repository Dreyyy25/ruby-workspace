<% if flash[:notice] %><p style="color: green;"><%= flash[:notice] %></p><% end %>

<h1>List of <%= @seminars.count %> Seminars</h1>

<table border="1">
  <tr>
    <th>Seminar number</th>
    <th>Date Started</th>
    <th>Date Ended</th>
    <th>Actions</th>
  </tr>
  <% @seminars.each do |seminar| %>
    <tr>
      <td><%= seminar.seminar_number %></td>
      <td><%= seminar.start_date.strftime("%-m/%-d/%Y") %></td>
      <td><%= seminar.end_date.strftime("%-m/%-d/%Y") %></td>
      <td>
        <%= link_to "Show", "/seminars/#{seminar.id}" %> |
        <%= link_to "Edit", "/seminars/#{seminar.id}/edit" %> |
        <form action="/seminars/<%= seminar.id %>" method="post" style="display: inline;">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <input type="hidden" name="_method" value="delete">
          <input type="submit" value="Delete">
        </form>
      </td>
    </tr>
  <% end %>
</table>

<p><%= link_to "Create new Seminar", "/seminars/new" %></p>

<div style="width: 500px; margin: 40px auto; font-family: sans-serif;">
  <% if flash[:notice] %>
    <div style="color: green; border: 1px solid green; padding: 10px; margin-bottom: 20px; background-color: #e6ffe6;">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <h1>Seminar #<%= @seminar.seminar_number %></h1>

  <p><strong>Start Date:</strong> <%= @seminar.date_started.strftime("%-m/%-d/%Y") %></p>
  <p><strong>End Date:</strong> <%= @seminar.date_ended.strftime("%-m/%-d/%Y") %></p>

  <br>
  <a href="/seminars">Home</a> |
  <a href="/seminars/<%= @seminar.id %>/edit">Edit</a>
</div>
<div style="width: 450px; margin: 40px auto; font-family: sans-serif;">
  <div style="border: 2px solid black; border-radius: 15px; padding: 30px;">
    <h1 style="text-align: center; margin-top: 0;">Submitted Entry</h1>

    <div style="margin-bottom: 15px; display: flex;">
      <span style="width: 180px; font-weight: normal;">Your Name (optional):</span>
      <strong><%= @result["name"].presence || "Anonymous" %></strong>
    </div>

    <div style="margin-bottom: 15px; display: flex;">
      <span style="width: 180px; font-weight: normal;">Course Title:</span>
      <strong><%= @result["course"] %></strong>
    </div>

    <div style="margin-bottom: 15px; display: flex;">
      <span style="width: 180px; font-weight: normal;">Given Score (1-10):</span>
      <strong><%= @result["score"] %>pts</strong>
    </div>

    <div style="margin-bottom: 25px;">
      <p style="margin: 0 0 5px 0;">Reason:</p>
      <p style="margin: 0;"><strong><%= @result["reason"] %></strong></p>
    </div>

    <div>
      <a href="/" style="display: inline-block; padding: 6px 16px; border: 2px solid black; color: black; text-decoration: none; font-weight: bold;">Return</a>
    </div>
  </div>
</div>
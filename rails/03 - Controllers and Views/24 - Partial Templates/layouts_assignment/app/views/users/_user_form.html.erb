<h3>Create User</h3>
<%= form_with(model: @user, local: true) do |f| %>
  <div class="mb-2">
    <%= f.label :first_name, class: "form-label" %>
    <%= f.text_field :first_name, class: "form-control" %>
  </div>
  <div class="mb-2">
    <%= f.label :last_name, class: "form-label" %>
    <%= f.text_field :last_name, class: "form-control" %>
  </div>
  <div class="mb-2">
    <%= f.label :favorite_language, class: "form-label" %>
    <%= f.text_field :favorite_language, class: "form-control" %>
  </div>
  <%= f.submit "Create User", class: "btn btn-primary mt-2" %>
<% end %>

<div class="mt-3">
  <%= link_to "Go to Posts", posts_path, class: "btn btn-secondary" %>
</div>
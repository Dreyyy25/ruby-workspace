<!DOCTYPE html>
<html>
  <head>
    <title>Three Column Layout</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body>
    <div class="container mt-4">
      <div class="row">
        <div class="col-4">
          <%= yield :left_column %>
        </div>
        <div class="col-4">
          <%= yield :middle_column %>
        </div>
        <div class="col-4">
          <%= yield :right_column %>
        </div>
      </div>
    </div>
  </body>
</html>
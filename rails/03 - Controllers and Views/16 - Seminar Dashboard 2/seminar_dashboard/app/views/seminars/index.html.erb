<div class="seminars-container">

  <div class="page-header">

    <h1>List of <%= Seminar.count %> Seminars</h1>

    <a href="/seminars/new" class="create-button">
      + Create New Seminar
    </a>

  </div>

  <table>
    <thead>
      <tr>
        <th>Seminar Number</th>
        <th>Date Started</th>
        <th>Date Ended</th>
      </tr>
    </thead>

    <tbody>
      <% @seminars.each do |seminar| %>
        <tr>
          <td><%= seminar.seminar_number %></td>
          <td><%= seminar.date_started.strftime("%m/%d/%Y") %></td>
          <td><%= seminar.date_ended.strftime("%m/%d/%Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

</div>
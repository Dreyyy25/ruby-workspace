<h1>Welcome to Ninja Gold</h1>

<h2>Your Gold: <%= @gold %></h2>

<div class="locations">

  <div>
    <h3>Farm</h3>
    <p>Earns 10 - 20 gold</p>

    <%= form_with url: rpg_farm_path, method: :post do %>
      <%= submit_tag "Find Gold!" %>
    <% end %>
  </div>

  <div>
    <h3>Cave</h3>
    <p>Earns 5 - 10 gold</p>

    <%= form_with url: rpg_cave_path, method: :post do %>
      <%= submit_tag "Find Gold!" %>
    <% end %>
  </div>

  <div>
    <h3>House</h3>
    <p>Earns 2 - 5 gold</p>

    <%= form_with url: rpg_house_path, method: :post do %>
      <%= submit_tag "Find Gold!" %>
    <% end %>
  </div>

  <div>
    <h3>Casino</h3>
    <p>Earn or lose 0 - 50 gold</p>

    <%= form_with url: rpg_casino_path, method: :post do %>
      <%= submit_tag "Find Gold!" %>
    <% end %>
  </div>

</div>

<h2>Activities</h2>

<div>
  <% @activities.reverse.each do |activity| %>
    <p><%= activity %></p>
  <% end %>
</div>
<h1>Create a New Product</h1>

<form action="/products" method="post">
  <!-- CSRF Security Token Protection -->
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

  <div>
    <label for="product_name">Name:</label>
    <input type="text" id="product_name" name="product[name]">
  </div>

  <div>
    <label for="product_quantity">Quantity:</label>
    <input type="number" id="product_quantity" name="product[quantity]">
  </div>

  <div>
    <label for="product_price">Price:</label>
    <input type="number" step="0.01" id="product_price" name="product[price]">
  </div>

  <input type="submit" value="Create Product">
</form>
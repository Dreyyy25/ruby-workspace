<h1>Edit Product <%= @product.id %></h1>

<form action="/products/<%= @product.id %>" method="post">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <input type="hidden" name="_method" value="patch">
  <p><label>Name: <input type="text" name="name" value="<%= @product.name %>"></label></p>
  <p><label>Quantity: <input type="number" name="quantity" value="<%= @product.quantity %>"></label></p>
  <p><label>Price: <input type="number" name="price" step="0.01" value="<%= @product.price %>"></label></p>
  <input type="submit" value="Update">
</form>

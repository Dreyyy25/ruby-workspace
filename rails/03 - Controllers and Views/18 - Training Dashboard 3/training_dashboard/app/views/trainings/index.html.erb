<% if flash[:notice] %><p style="color: green;"><%= flash[:notice] %></p><% end %>

<h1>List of <%= @trainings.count %> Trainings</h1>

<table border="1">
  <tr>
    <th>Training number</th>
    <th>Date Started</th>
    <th>Date Ended</th>
    <th>Actions</th>
  </tr>
  <% @trainings.each do |training| %>
    <tr>
      <td><%= training.training_number %></td>
      <td><%= training.start_date.strftime("%-m/%-d/%Y") %></td>
      <td><%= training.end_date.strftime("%-m/%-d/%Y") %></td>
      <td>
        <%= link_to "Show", "/trainings/#{training.id}" %> |
        <%= link_to "Edit", "/trainings/#{training.id}/edit" %> |
        <form action="/trainings/<%= training.id %>" method="post" style="display: inline;">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <input type="hidden" name="_method" value="delete">
          <input type="submit" value="Delete">
        </form>
      </td>
    </tr>
  <% end %>
</table>

<p><%= link_to "Create new Training", "/trainings/new" %></p>

<h1>New seminar #<%= @seminar_id %> attendee</h1>

<%= form_with model: @attendee, url: "/seminars/#{@seminar_id}/attendees" do |form| %>
  <% if @attendee.errors.any? %>
    <div style="color: red;">
      <h2><%= pluralize(@attendee.errors.count, "error") %> prohibited this attendee from being saved:</h2>
      <ul>
        <% @attendee.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 8px;">
    <%= form.label :first_name %><br>
    <%= form.text_field :first_name %>
  </div>

  <div style="margin-bottom: 8px;">
    <%= form.label :last_name %><br>
    <%= form.text_field :last_name %>
  </div>

  <div style="margin-bottom: 8px;">
    <%= form.label :email %><br>
    <%= form.text_field :email %>
  </div>

  <%= form.submit "Add attendee" %>
<% end %>

<%= link_to "Back to seminar", "/seminars/#{@seminar_id}" %>

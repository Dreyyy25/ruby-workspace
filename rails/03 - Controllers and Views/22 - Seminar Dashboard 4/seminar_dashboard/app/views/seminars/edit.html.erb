<div class="seminar-form-container">

  <h1>Edit Seminar</h1>

  <% if @seminar.errors.any? %>

    <div class="error-box">

      <h2>Please fix the following errors:</h2>

      <ul>
        <% @seminar.errors.full_messages.each do |error| %>
          <li><%= error %></li>
        <% end %>
      </ul>

    </div>

  <% end %>

  <form
    action="/seminars/<%= @seminar.id %>"
    method="POST"
  >

    <input
      type="hidden"
      name="_method"
      value="PATCH"
    >

    <div class="form-group">

      <label for="seminar_number">
        Seminar Number
      </label>

      <input
        type="number"
        id="seminar_number"
        name="seminar[seminar_number]"
        value="<%= @seminar.seminar_number %>"
        min="1"
        step="1"
      >

    </div>

    <div class="form-group">

      <label for="date_started">
        Date Started
      </label>

      <input
        type="date"
        id="date_started"
        name="seminar[date_started]"
        value="<%= @seminar.date_started %>"
      >

    </div>

    <div class="form-group">

      <label for="date_ended">
        Date Ended
      </label>

      <input
        type="date"
        id="date_ended"
        name="seminar[date_ended]"
        value="<%= @seminar.date_ended %>"
      >

    </div>

    <button
      type="submit"
      class="submit-button"
    >
      Update Seminar
    </button>

  </form>

  <a
    href="/seminars/<%= @seminar.id %>"
    class="back-link"
  >
    ← Back to Seminar
  </a>

</div>
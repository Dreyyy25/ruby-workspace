<div style="width: 500px; margin: 40px auto; font-family: sans-serif;">
  <% if flash[:notice] %>
    <div style="color: green; border: 1px solid green; padding: 10px; margin-bottom: 20px; background-color: #e6ffe6;">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <h1>Seminar #<%= @seminar.seminar_number %> <%= @attendee.first_name %> <%= @attendee.last_name %></h1>
  <p><strong>Email:</strong> <%= @attendee.email %></p>

  <br>

  <h3>co-attendee</h3>
  <table style="width: 100%; border-collapse: collapse; border: 2px solid black;">
    <thead>
      <tr style="background-color: #e0e0e0; text-align: left;">
        <th style="border: 1px solid black; padding: 8px;">Last Name</th>
        <th style="border: 1px solid black; padding: 8px;">First Name</th>
      </tr>
    </thead>
    <tbody>
      <% @co_attendees.each do |mate| %>
        <tr>
          <td style="border: 1px solid black; padding: 8px;"><%= mate.last_name %></td>
          <td style="border: 1px solid black; padding: 8px;"><%= mate.first_name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br><br>
  <a href="/seminars">Home</a> |
  <a href="/seminars/<%= @seminar.id %>/attendees/<%= @attendee.id %>/edit">Edit</a>
</div>